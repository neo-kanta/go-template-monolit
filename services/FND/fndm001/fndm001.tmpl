        /// <returns>ResultModel</returns>
        /// <exception cref="NotImplementedException">未實作處理</exception>
        public async Task<ResultModel> Handle(TACKFundCodeExistCHKRequest request, CancellationToken cancellationToken)
        {
            return request.Action switch
            {
                ActionType.ChkData => request.ActMethod switch
                {
                    "TACKFundCodeExist" => await TACKFundCodeExist(request),
                    _ => throw new NotImplementedException()
                },
                _ => throw new NotImplementedException()
            };
        }

        /// <summary> 檢核基金代碼是否已被設定過 </summary>
        /// <param name="request">TACKFundCodeExistCHKRequest</param>
        /// <returns>ResultModel</returns>
        private async Task<ResultModel> TACKFundCodeExist(TACKFundCodeExistCHKRequest request)
        {
            ResultModel result = new();
            result.SetSuccess();

            IQueryable<string> real = _DbSet.DTA_FND_FundDetail.Where(p => p.SysCoID == request.SysCoID && p.FundCode == request.FundCode).Select(p => p.FundCode);
            IQueryable<string> edit = _DbSet.DTA_FND_FundDetail_Edit.Where(p => p.SysCoID == request.SysCoID && p.FundCode == request.FundCode).Select(p => p.FundCode);

            List<IQueryable<string>> dto = [real, edit];

            if (Validate(dto))
            {
                MessageInfo msgInfo = BaseMsgInfo.GetMsg(_Productid, "TA00030", _Langid);
                result.SetError(msgInfo.MsgContent, ResultCodeType.Fail, msgInfo.MsgType);
            }

            static bool Validate(List<IQueryable<string>> datas)
            {
                bool flag = false;

                foreach (var item in datas)
                {
                    if (item.Any())
                    {
                        flag = true;
                        break;
                    }
                }

                return flag;
            }

            return await Task.FromResult(result);
        }
    }

    #endregion 額外提供檢核 Handler

    #region Methods

    /// <summary> TAFNDFundInfo 私有方法集合 </summary>
    internal class TAFNDFundInfoMethods
    {
        private readonly BaseHubUtility baseHub;

        /// <summary> Constructor </summary>
        /// <param name="baseQuery">IBaseQuery</param>
        /// <param name="langCode">string</param>
        public TAFNDFundInfoMethods(string langCode, bool isMainLang)
        {
            baseHub = new(langCode, isMainLang);
        }

        /// <summary> 取得下拉式選項內容 </summary>
        /// <param name="OptionID">OptID(可多組，用逗號串接)</param>
        /// <returns>Dictionary</returns>
        public async Task<Dictionary<(string, string), string>> GetOpt(string OptionID)
        {
            //取得下拉式選項內容
            GetOptionRequest options = new() { OptID = OptionID };
            var dicOpt = (await baseHub.GetOption(options)).Master.ToDictionary(p => (p.OptID, p.ItemID), p => p.ItemName);

            return dicOpt;
        }

        /// <summary> 取得幣別名稱 </summary>
        /// <param name="cryid">CryID</param>
        /// <returns>Dictionary</returns>
        public async Task<Dictionary<string, (string, int)>> GetCryNM(string cryid)
        {
            GetCryRequest cryRq = new() { CryID = cryid };
            Dictionary<string, (string, int)> cryData = (await baseHub.GetCry(cryRq)).Master.ToDictionary(p => p.CryID, p => (p.CryIDNM, p.DecLen));

            return cryData;
        }
    }

    #endregion Methods
