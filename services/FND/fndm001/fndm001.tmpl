    /// <summary> TACKCSDPrtFundSetlDateCHKHandler </summary>
    public class TACKCSDPrtFundSetlDateCHKHandler : TAHandlerQuery, IRequestHandler<TACKCSDPrtFundSetlDateCHKRequest, ResultModel>
    {
        /// <summary> TACKCSDPrtFundSetlDateCHKHandler Constructor </summary>
        /// <param name="basequery">IBaseQuery</param>
        /// <param name="baseApiService">BaseApiService</param>
        public TACKCSDPrtFundSetlDateCHKHandler(IBaseQuery basequery, BaseApiService baseApiService) : base(basequery, baseApiService)
        { }

        /// <summary> TACKCSDPrtFundSetlDateCHKHandler Handle </summary>
        /// <param name="request">TACKCSDPrtFundSetlDateCHKRequest</param>
        /// <param name="cancellationToken">CancellationToken</param>
        /// <returns>ResultModel</returns>
        /// <exception cref="NotImplementedException">未實作處理</exception>
        public async Task<ResultModel> Handle(TACKCSDPrtFundSetlDateCHKRequest request, CancellationToken cancellationToken)
        {
            return request.Action switch
            {
                ActionType.ChkData => request.ActMethod switch
                {
                    "TACKCSDPrtFundSetlDate" => await TACKCSDPrtFundSetlDate(request),
                    _ => throw new NotImplementedException()
                },
                _ => throw new NotImplementedException()
            };
        }

        /// <summary> 檢核集保平台款項生效日期 </summary>
        /// <param name="request">TACKCSDPrtFundSetlDateCHKRequest</param>
        /// <returns>ResultModel</returns>
        private async Task<ResultModel> TACKCSDPrtFundSetlDate(TACKCSDPrtFundSetlDateCHKRequest request)
        {
            ResultModel result = new();
            GetSystemValueRequest sysRq = new() { SysCoID = request.SysCoID, SysCode = "000021" };

            result.SetSuccess();

            //系統日期
            DateTimeOffset DBDate = DatabaseUtility.GetDatabaseCurrentTime();

            //預設日期
            DateTimeOffset defaultDate = BaseDefaultValue.DefaultDate;

            //集保平台款項生效日參數
            string strSysValue = (await BaseHubUtility.GetSystemValue(sysRq)).SysValue;
            int SysValue = Convert.ToInt32(strSysValue);

            //GetBasicBusinessDate Query
            DateBizUtility DateBiz = new(_BaseQuery, _Langid);
            GetBasicBusinessDateRequest rq = new()
            {
                SysCoID = request.SysCoID,
                CalType = BasicCalType.CB,
                BasicDate = DBDate,
                CalDays = SysValue
            };

            //可生效日期
            DateTimeOffset EffDate = (await DateBiz.GetBasicBusinessDate(rq)).CalDate;

            if (request.CSDPrtFundSetlDate.GetValueOrDefault(defaultDate) < EffDate)
            {
                if (!string.IsNullOrWhiteSpace(request.FundCode))
                {
                    MessageInfo msgInfo = BaseMsgInfo.GetMsg(_Productid, "FNDM001014", _Langid);
                    result.SetError(string.Format(msgInfo.MsgContent, request.FundCode, request.CSDPrtFundSetlDate?.ToString("yyyy/MM/dd"), SysValue.ToString()), ResultCodeType.Fail, msgInfo.MsgType);
                }
                else
                {
                    MessageInfo msgInfo = BaseMsgInfo.GetMsg(_Productid, "FNDM001009", _Langid);
                    result.SetError(string.Format(msgInfo.MsgContent, request.CSDPrtFundSetlDate?.ToString("yyyy/MM/dd"), SysValue.ToString()), ResultCodeType.Fail, msgInfo.MsgType);
                }
            }

            return result;
        }
    }

