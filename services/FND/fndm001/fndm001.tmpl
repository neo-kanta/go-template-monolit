namespace Systemweb.ACETA.TaAPI.Controllers.TA.Fund
{
    /// <summary> 基金基本資料維護作業 Controller </summary>
    [Route("TAapi/Fund/[controller]")]
    [ApiController]
    [Authorize(Roles = OAuthDefaults.RoleUser)]
    public class TAFNDFundInfoController : TAApiController
    {
        /// <summary> TAFNDFundInfoCtl Interface </summary>
        private readonly ITAFNDFundInfoCtl _Ctl;

        /// <summary> 基金基本資料維護作業 Controller Constructor </summary>
        /// <param name="di">BaseApiService</param>
        /// <param name="control">TAFNDFundInfoCtl</param>
        public TAFNDFundInfoController(BaseApiService di, IBaseControl<TAFNDFundInfoCtl> control) : base(di)
        {
            _Ctl = control.Create();
        }

        #region AUD相關

        /// <summary>APIFNDM001Post-基金基本資料維護作業 新增</summary>
        /// <param name="request">TAFNDFundInfoRequest</param>
        /// <returns>AUDResponse</returns>
        [HttpPost]
        public async Task<ActionResult<ResultModel<AUDResponse>>> PostAUDData([FromBody] TAFNDFundInfoRequest request)
        {
            return await RunAsync(request, async request =>
            {
                return await _Ctl.AUDData(request);
            });
        }

        /// <summary>APIFNDM001Put-基金基本資料維護作業 修改</summary>
        /// <param name="request">TAFNDFundInfoRequest</param>
        /// <returns>AUDResponse</returns>
        [HttpPut]
        public async Task<ActionResult<ResultModel<AUDResponse>>> PutAUDData([FromBody] TAFNDFundInfoRequest request)
        {
            return await RunAsync(request, async request =>
            {
                return await _Ctl.AUDData(request);
            });
        }

        /// <summary>APIFNDM001Delete-基金基本資料維護作業 刪除</summary>
        /// <param name="DataID">DataID</param>
        /// <param name="DataFlag">DataFlag</param>
        /// <returns>AUDResponse</returns>
        [HttpDelete]
        [Route("Delete/{DataID}/{DataFlag}")]
        public async Task<ActionResult<ResultModel<AUDResponse>>> DeleteAUDData(string DataID, string DataFlag)
        {
            _ = Guid.TryParse(DataID, out Guid dataID);
            byte[] dataFlag = Convert.FromBase64String(DecodeUrlBase64String(DataFlag));
            TAFNDFundInfoRequest request = new() { Master = new TAFNDFundInfo { DataID = dataID, DataFlag = dataFlag } };

            return await RunDeleteAsync(request, async request =>
            {
                request.SetAction(ActionOption.Delete);

                return await _Ctl.AUDData(request);
            });
        }

        /// <summary>APIFNDM001Recover-基金基本資料維護作業 復原</summary>
        /// <param name="DataID">DataID</param>
        /// <param name="DataFlag">DataFlag</param>
        /// <returns>AUDResponse</returns>
        [HttpDelete]
        [Route("Recover/{DataID}/{DataFlag}")]
        public async Task<ActionResult<ResultModel<AUDResponse>>> RecoverAUDData(string DataID, string DataFlag)
        {
            _ = Guid.TryParse(DataID, out Guid dataID);
            byte[] dataFlag = Convert.FromBase64String(DecodeUrlBase64String(DataFlag));
            TAFNDFundInfoRequest request = new() { Master = new TAFNDFundInfo { DataID = dataID, DataFlag = dataFlag } };

            return await RunDeleteAsync(request, async request =>
            {
                request.SetAction(ActionOption.Recover);

                return await _Ctl.AUDData(request);
            });
        }

        /// <summary>APIFNDM001Unlock-基金基本資料維護作業 解鎖</summary>
        /// <param name="DataID">DataID</param>
        /// <param name="DataFlag">DataFlag</param>
        /// <returns>AUDResponse</returns>
        [HttpDelete]
        [Route("Unlock/{DataID}/{DataFlag}")]
        public async Task<ActionResult<ResultModel<AUDResponse>>> UnlockAUDData(string DataID, string DataFlag)
        {
            _ = Guid.TryParse(DataID, out Guid dataID);
            byte[] dataFlag = Convert.FromBase64String(DecodeUrlBase64String(DataFlag));
            TAFNDFundInfoRequest request = new() { Master = new TAFNDFundInfo { DataID = dataID, DataFlag = dataFlag } };

            return await RunDeleteAsync(request, async request =>
            {
                request.SetAction(ActionOption.Unlock);

                return await _Ctl.AUDData(request);
            });
        }

        #endregion AUD相關

        #region 查詢相關

        /// <summary>APIFNDM001Get-基金基本資料維護作業 一般查詢</summary>
        /// <param name="filters">TAFNDFundInfoFilterRequest</param>
        /// <returns>TAFNDFundInfoResponse</returns>
        [HttpGet]
        [Route("GetData")]
        public async Task<ActionResult<ResultModel<TAFNDFundInfoResponse>>> GetData([FromQuery] TAFNDFundInfoFilterRequest filters)
        {
            return await RunAsync(filters, async request =>
            {
                return await _Ctl.GetData(request);
            });
        }

        /// <summary>APIFNDM001GetMaintain-基金基本資料維護作業 Maintain查詢</summary>
        /// <param name="DataID">DataID</param>
        /// <returns>TAFNDFundInfoAUDResponse</returns>
        [HttpGet]
        [Route("GetData/{DataID}")]
        public async Task<ActionResult<ResultModel<TAFNDFundInfoAUDResponse>>> GetData(string DataID)
        {
            _ = Guid.TryParse(DataID, out Guid dataID);
            TAFNDFundInfoQueryRequest filters = new() { DataID = dataID };

            return await RunAsync(filters, async request =>
            {
                request.SetAction(ActionType.GetMaintainData);
                return await _Ctl.GetMaintainData(request);
            });
        }

        /// <summary>GFNDM00101-取得境內母基金發行幣別代碼(For Searcher) Info查詢</summary>
        /// <param name="filters">TAGetDPrtFundIssueCryRequest</param>
        /// <returns>TAGetDPrtFundIssueCryResponse</returns>
        [HttpGet]
        [Route("GetInfo/TAGetDPrtFundIssueCry")]
        public async Task<ActionResult<ResultModel<TAGetDPrtFundIssueCryResponse>>> TAGetDPrtFundIssueCry([FromQuery] TAGetDPrtFundIssueCryRequest filters)
        {
            return await RunAsync(filters, async request =>
            {
                request.SetActionMethod("TAGetDPrtFundIssueCry");
                return await _Ctl.TAGetDPrtFundIssueCry(request);
            });
        }

        /// <summary>GFNDM00104-取得境內基金可交易幣別代碼(For Searcher) Info查詢</summary>
        /// <param name="filters">TAGetDTxCryRequest</param>
        /// <returns>TAGetDTxCryResponse</returns>
        [HttpGet]
        [Route("GetInfo/TAGetDTxCry")]
        public async Task<ActionResult<ResultModel<TAGetDTxCryResponse>>> TAGetDTxCry([FromQuery] TAGetDTxCryRequest filters)
        {
            return await RunAsync(filters, async request =>
            {
                request.SetActionMethod("TAGetDTxCry");
                return await _Ctl.TAGetDTxCry(request);
            });
        }

        #endregion 查詢相關

        #region 檢核相關

        /// <summary>KFNDM00101-檢核集保平台款項生效日期</summary>
        /// <param name="CHK">TACKCSDPrtFundSetlDateCHKRequest</param>
        /// <returns>ResultModel</returns>
        [HttpGet]
        [Route("ChkData/TACKCSDPrtFundSetlDate")]
        public async Task<ActionResult<ResultModel>> TACKCSDPrtFundSetlDate([FromQuery] TACKCSDPrtFundSetlDateCHKRequest CHK)
        {
            CHK.SetActionMethod("TACKCSDPrtFundSetlDate");
            return await _Ctl.TACKCSDPrtFundSetlDate(CHK);
        }

        /// <summary>KFNDM00103-檢核基金代碼是否已被設定過</summary>
        /// <param name="CHK">TACKFundCodeExistCHKRequest</param>
        /// <returns>ResultModel</returns>
        [HttpGet]
        [Route("ChkData/TACKFundCodeExist")]
