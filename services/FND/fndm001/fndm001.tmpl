    /// <summary> 基金資訊(共用)檔 一般查詢 Handler </summary>
    public class TAFNDFundInfoHandler : TAHandlerQuery, IRequestHandler<TAFNDFundInfoFilterRequest, ResultModel<TAFNDFundInfoResponse>>
    {
        private readonly BaseApiService _Service;

        /// <summary> TAFNDFundInfoHandler Constructor </summary>
        /// <param name="basequery">IBaseQuery</param>
        /// <param name="baseApiService">BaseApiService</param>
        /// <param name="mapper">IMapper</param>
        public TAFNDFundInfoHandler(IBaseQuery basequery, BaseApiService baseApiService) : base(basequery, baseApiService)
        {
            _Service = baseApiService;
        }

        /// <summary> Handle </summary>
        /// <param name="request">TAFNDFundInfoFilterRequest</param>
        /// <param name="cancellationToken">CancellationToken</param>
        /// <returns>TAFNDFundInfoResponse</returns>
        public async Task<ResultModel<TAFNDFundInfoResponse>> Handle(TAFNDFundInfoFilterRequest request, CancellationToken cancellationToken)
        {
            var real = from p in _DbSet.TA_FND_FundInfo
                       where p.Inspect >= 900 && p.SysCoID == request.SysCoID
                          && p.ShoreID == ShoreID.DTA
                          && p.IsETF == MapYN.No
                       select new
                       {
                           p.SysCoID,
                           p.PrtFundCode,
                           p.UniCode,
                           p.FundInShName,
                           p.FundMName,
                           p.FundShMName,
                           p.FundSName,
                           p.FundShSName,
                           p.FundRiskLevel,
                           p.IssueBaseCry,
                           p.FundSetupDate,
                           p.FundStatus,
                           p.DataID,
                           p.CreateID,
                           p.CreateDate,
                           p.Inspect,
                           p.FlowID,
                           p.InspectID,
                           p.InspectDate,
                           p.UpdateID,
                           p.UpdateDate,
                           p.DataFlag,
                           p.DiffColumns,
                       };

            //固定條件
            if (request.InspectSwitch is not null && request.InspectSwitch != 0)
                real = real.Where(g => g.Inspect / 100 == request.InspectSwitch);

            var edit = from p in _DbSet.TA_FND_FundInfo_Edit
                       where p.Inspect < 900 && p.SysCoID == request.SysCoID
                          && p.ShoreID == ShoreID.DTA
                          && p.IsETF == MapYN.No
                       select new
                       {
                           p.SysCoID,
                           p.PrtFundCode,
                           p.UniCode,
                           p.FundInShName,
                           p.FundMName,
                           p.FundShMName,
                           p.FundSName,
                           p.FundShSName,
                           p.FundRiskLevel,
                           p.IssueBaseCry,
                           p.FundSetupDate,
                           p.FundStatus,
                           p.DataID,
                           p.CreateID,
                           p.CreateDate,
                           p.Inspect,
                           p.FlowID,
                           p.InspectID,
                           p.InspectDate,
                           p.UpdateID,
                           p.UpdateDate,
                           p.DataFlag,
                           p.DiffColumns,
                       };

            //固定條件
            if (request.InspectSwitch is not null && request.InspectSwitch != 0)
                edit = edit.Where(g => g.Inspect / 100 == request.InspectSwitch);

            var query = real.Concat(edit);

            #region Conditions

            if (!string.IsNullOrWhiteSpace(request.PrtFundCode))
                query = query.Where(p => p.PrtFundCode == request.PrtFundCode);

            if (!string.IsNullOrWhiteSpace(request.UniCode))
                query = query.Where(p => p.UniCode == request.UniCode);

            #endregion Conditions

            var data = await (from p in query
                              orderby p.SysCoID, p.PrtFundCode, p.UniCode
                              select p).ToListAsync(cancellationToken);

            //查詢結果
            List<TAFNDFundInfoDTO> list = new();

            if (data.Count > 0)
            {
                TAFNDFundInfoMethods method = new(_Langid, _IsMainLang);
                string cryIDs = string.Join(",", data.Select(p => p.IssueBaseCry));
                string? nm;

                // Get Opt
                Dictionary<(string, string), string> dicOpt = await method.GetOpt("000003,000007");

                // Get CryNM
                Dictionary<string, (string CryIDNM, int DecLen)> dicCry = await method.GetCryNM(cryIDs);

                // data mapping
                list = data.Select(p => new TAFNDFundInfoDTO
                {
                    PrtFundCode = p.PrtFundCode,
                    UniCode = p.UniCode,
                    FundInShName = p.FundInShName,
                    FundMName = p.FundMName,
                    FundShMName = p.FundShMName,
                    FundSName = p.FundSName,
                    FundShSName = p.FundShSName,
                    FundRiskLevelNM = dicOpt.TryGetValue(("000003", p.FundRiskLevel), out nm) ? nm : string.Empty,
                    IssueBaseCry = p.IssueBaseCry,
                    IssueBaseCryNM = dicCry.TryGetValue(p.IssueBaseCry, out var tuple) ? tuple.CryIDNM : string.Empty,
                    FundSetupDate = p.FundSetupDate,
                    FundStatusNM = dicOpt.TryGetValue(("000007", p.FundStatus), out nm) ? nm : string.Empty,
                    DataID = p.DataID,
                    CreateID = p.CreateID,
                    CreateDate = p.CreateDate,
                    Inspect = p.Inspect,
                    FlowID = p.FlowID,
                    InspectID = p.InspectID,
                    InspectDate = p.InspectDate,
                    UpdateID = p.UpdateID,
                    UpdateDate = p.UpdateDate,
                    DataFlag = p.DataFlag,
                    DiffColumns = p.DiffColumns,
                }).ToList();
            }

            //回傳結果
            return GetQueryResult<TAFNDFundInfoDTO, TAFNDFundInfoResponse>(list, false);
        }
    }

    #endregion 一般查詢 Handler

