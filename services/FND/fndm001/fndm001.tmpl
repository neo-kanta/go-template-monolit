                GetBankVNMRequest bankNMRq = new();
                GetCodeRequest codeRq = new() { CodeType = "001,021,022,030,031,033", SysCoID = master.SysCoID };
                GetDFundNMRequest DfundNMRq = new() { SysCoID = master.SysCoID };
                GetCodeTypeRequest codeTypeRq = new() { CustomUse = "F1" };

                //dto
                List<TAFNDFundInfoMaintainMasterDTO?> MaintainMasterList = [MasterEdit, MasterReal];
                MaintainMasterList = MaintainMasterList.Where(p => p is not null).ToList();
                List<List<DTACryGroupListDTO>> DTACryGroupLists = [DTACryGroupListEdit, DTACryGroupListReal];
                List<List<DTAFundDetailListDTO>> DTAFundDetailLists = [DTAFundDetailListEdit, DTAFundDetailListReal];
                List<List<DTAFundAccountListDTO>> DTAFundAccountLists = [DTAFundAccountListEdit, DTAFundAccountListReal];
                List<List<DTAFundRelGroupListDTO>> DTAFundRelGroupLists = [DTAFundRelGroupListEdit, DTAFundRelGroupListReal];
                List<string> bankIDList = [];
                List<string> DFundCodeList = [];
                List<string> codeTypeList = [];
                (string CryIDNM, int DecLen) crytuple;
                string? nm;

                #endregion variables

                #region utility requests gathering

                //master
                //SysCoIDNM request
                conmRq.SysCoID = master.SysCoID;

                MaintainMasterList.ForEach(p =>
                {
                    //GetCryNM request
                    cryIDList.Add(p!.IssueBaseCry);
                    cryIDList.Add(p!.TMFReturnBC);
                });

                //details
                DTACryGroupLists.ForEach(p =>
                {
                    p.ForEach(i =>
                    {
                        //GetCryNM request
                        cryIDList.Add(i.IssueCry);
                        cryIDList.Add(i.OthTxCry);

                        //GetBankVNM request
                        bankIDList.Add(i.FundMBankBrh);
                    });
                });

                DTAFundDetailLists.ForEach(p =>
                {
                    p.ForEach(i =>
                    {
                        //GetCryNM request
                        cryIDList.Add(i.FundCry);

                        //GetDFundNM request
                        DFundCodeList.Add(i.MatureFund);
                    });
                });

                DTAFundAccountLists.ForEach(p =>
                {
                    p.ForEach(i =>
                    {
                        //GetBankVNM request
                        bankIDList.Add(i.CusBankBrh);
                    });
                });

                DTAFundRelGroupLists.ForEach(p =>
                {
                    p.ForEach(i =>
                    {
                        //GetCodeType request
                        codeTypeList.Add(i.FundGroupNo);
                    });
                });

                #endregion utility requests gathering

                #region retrieve data for update

                //SysCoIDNM
                string _sysCoIDNM = (await bq.GetSysCoNM(conmRq)).Master.FirstOrDefault()?.SysCoIDNM ?? string.Empty;

                //BankV
                bankRq.BankID = string.Join(",", MaintainMasterList.Select(p => p!.CustBankHeadID));
                Dictionary<string, (string BankIDNM, string SWIFTCode, string BankSName, string ZipAddr)> dicBankV = (await bq.GetBankV(bankRq)).Master
                .ToDictionary(d => d.BankID, d => (d.BankIDNM, d.SWIFTCode, d.BankSName, d.ZipAddr));

                //CryIDNM data
                Dictionary<string, (string, int)> dicCryNM = await method.GetCryNM(string.Join(",", cryIDList));

                //BankVNM
                bankNMRq.BankID = string.Join(",", bankIDList);
                Dictionary<string, (string BankIDNM, string SWIFTCode)> dicBankNM = (await bq.GetBankVNM(bankNMRq)).Master.ToDictionary(p => p.BankID, p => (p.BankIDNM, p.SWIFTCode));

                //CodeNM
                Dictionary<(string, string), string> dicCodeNM = (await bq.GetCode(codeRq)).Master.ToDictionary(p => (p.CodeType, p.Code), p => p.CodeNM);

                //DFundNM
                DfundNMRq.FundCode = string.Join(",", DFundCodeList);
                Dictionary<string, string> dicDFundNM = (await bfq.GetDFundNM(DfundNMRq)).Master.ToDictionary(p => p.FundCode, p => p.FundCodeNM);

                //CodeTypeNM
                codeTypeRq.CodeType = string.Join(",", codeTypeList);
                Dictionary<string, string> dicCodeTypeNM = (await bq.GetCodeType(codeTypeRq)).Master.ToDictionary(p => p.CodeType, p => p.CodeTypeNM);

                #endregion retrieve data for update

                #region update

                //master
                MaintainMasterList.ForEach(p =>
                {
                    p!.SysCoIDNM = _sysCoIDNM;
                    p!.IssueBaseCryNM = dicCryNM.TryGetValue(p.IssueBaseCry, out crytuple) ? crytuple.CryIDNM : string.Empty;
                    p!.SITCAFundTypeNM = dicCodeNM.TryGetValue(("001", p.SITCAFundType), out nm) ? nm : string.Empty;
                    p!.CustBankHeadIDNM = string.Empty;
                    p!.SWIFTCode = string.Empty;
                    p!.BankSName = string.Empty;
                    p!.Addr = string.Empty;
                    p!.SubsFeeGroupNM = dicCodeNM.TryGetValue(("021", p.SITCAFundType), out nm) ? nm : string.Empty;
                    p!.CDSCFeeGroupNM = dicCodeNM.TryGetValue(("021", p.SITCAFundType), out nm) ? nm : string.Empty;
                    p!.DivFundGroupNM = dicCodeNM.TryGetValue(("030", p.SITCAFundType), out nm) ? nm : string.Empty;
                    p!.TMFReturnBCNM = dicCryNM.TryGetValue(p.TMFReturnBC, out crytuple) ? crytuple.CryIDNM : string.Empty;

                    dicBankV.TryGetValue(p.CustBankHeadID, out var tuple);
                    p!.CustBankHeadIDNM = tuple.BankIDNM ?? string.Empty;
                    p!.SWIFTCode = tuple.SWIFTCode ?? string.Empty;
                    p!.BankSName = tuple.BankSName ?? string.Empty;
                    p!.Addr = tuple.ZipAddr ?? string.Empty;
                });

                //details
                DTACryGroupLists.ForEach(p =>
                {
                    p.ForEach(i =>
                    {
                        i.IssueCryNM = dicCryNM.TryGetValue(i.IssueCry, out crytuple) ? crytuple.CryIDNM : string.Empty;
                        i.OthTxCryNM = dicCryNM.TryGetValue(i.OthTxCry, out crytuple) ? crytuple.CryIDNM : string.Empty;
                        i.FundMBankBrhNM = string.Empty;
                        i.SWIFTCode = string.Empty;

                        if (dicBankNM.TryGetValue(i.FundMBankBrh, out var tuple))
                        {
                            i.FundMBankBrhNM = tuple.BankIDNM;
                            i.SWIFTCode = tuple.SWIFTCode;
                        }
                    });
                });

                DTAFundDetailLists.ForEach(p =>
                {
                    p.ForEach(i =>
                    {
                        i.FundCryNM = dicCryNM.TryGetValue(i.FundCry, out crytuple) ? crytuple.CryIDNM : string.Empty;
                        i.FHFundShareNM = dicCodeNM.TryGetValue(("031", i.FHFundShare), out nm) ? nm : string.Empty;

                        i.MatureFundNM = dicDFundNM.TryGetValue(i.MatureFund, out nm) ? nm : string.Empty;
                    });
                });

                DTAFundAccountLists.ForEach(p =>
                {
                    p.ForEach(i =>
                    {
                        i.CusBankBrhNM = string.Empty;
                        i.SWIFTCode = string.Empty;

                        if (dicBankNM.TryGetValue(i.CusBankBrh, out var tuple))
                        {
                            i.CusBankBrhNM = tuple.BankIDNM;
                            i.SWIFTCode = tuple.SWIFTCode;
                        }
                    });
                });

                DTAFundRelGroupLists.ForEach(p =>
                {
                    string _code = string.Empty;

                    p.ForEach(i =>
                    {
                        i.FundGroupNoNM = dicCodeTypeNM.TryGetValue(i.FundGroupNo, out nm) ? nm : string.Empty;

                        //通路服務費
                        if (i.GroupTypeNo == "022")
                            _code = "022";
                        //基金停利
                        else if (i.GroupTypeNo == "033")
                            _code = "033";

                        i.GroupTypeNoNM = dicCodeNM.TryGetValue((_code, i.GroupTypeNo), out nm) ? nm : string.Empty;
                    });
                });

                #endregion update
            }

            #endregion update master & details

            List<StructMDetail> lstMD = new()
            {
                new() { listName = "Master", readTable = MasterReal, editTable = MasterEdit },
                new() { listName = "DTACustContactList", readTable = DTACustContactListReal, editTable = DTACustContactListEdit },
                new() { listName = "DTACryGroupList", readTable = DTACryGroupListReal, editTable = DTACryGroupListEdit },
                new() { listName = "DTAFundDetailList", readTable = DTAFundDetailListReal, editTable = DTAFundDetailListEdit },
                new() { listName = "DTAFundAccountList", readTable = DTAFundAccountListReal, editTable = DTAFundAccountListEdit },
                new() { listName = "DTAFundRelGroupList", readTable = DTAFundRelGroupListReal, editTable = DTAFundRelGroupListEdit },
                new() { listName = "DTAFundDisFeeList", readTable = DTAFundDisFeeListReal, editTable = DTAFundDisFeeListEdit },
                new() { listName = "DTAFundTxCryList", readTable = DTAFundTxCryListReal, editTable = DTAFundTxCryListEdit },
                new() { listName = "DTAShortDtlList", readTable = DTAShortDtlListReal, editTable = DTAShortDtlListEdit },
                new() { listName = "DTAFundAntiDilList", readTable = DTAFundAntiDilListReal, editTable = DTAFundAntiDilListEdit },
                new() { listName = "DTAFundAntiDilAdjList", readTable = DTAFundAntiDilAdjListReal, editTable = DTAFundAntiDilAdjListEdit },
                new() { listName = "DTAFundAntiDilMechList", readTable = DTAFundAntiDilMechListReal, editTable = DTAFundAntiDilMechListEdit },
                new() { listName = "DTAFundMGTFeeList", readTable = DTAFundMGTFeeListReal, editTable = DTAFundMGTFeeListEdit },
                new() { listName = "DTAMGTFeeDtlList", readTable = DTAMGTFeeDtlListReal, editTable = DTAMGTFeeDtlListEdit }
