    /// <summary> 取得境內母基金發行幣別代碼(For Searcher) TAGetDPrtFundIssueCry Info Handler </summary>
    public class TAGetDPrtFundIssueCryHandler : TAHandlerQuery, IRequestHandler<TAGetDPrtFundIssueCryRequest, ResultModel<TAGetDPrtFundIssueCryResponse>>
    {
        /// <summary> TAGetDPrtFundIssueCryHandler Constructor </summary>
        /// <param name="basequery">IBaseQuery</param>
        /// <param name="baseApiService">BaseApiService</param>
        public TAGetDPrtFundIssueCryHandler(IBaseQuery basequery, BaseApiService baseApiService) : base(basequery, baseApiService)
        { }

        /// <summary> 取得境內母基金發行幣別代碼(For Searcher) TAGetDPrtFundIssueCry Info Handler </summary>
        /// <param name="request">TAGetDPrtFundIssueCryRequest</param>
        /// <returns>TAGetDPrtFundIssueCryResponse</returns>
        public async Task<ResultModel<TAGetDPrtFundIssueCryResponse>> Handle(TAGetDPrtFundIssueCryRequest request, CancellationToken cancellationToken)
        {
            bool _QueryTypeIsSMP = request.QueryType == ApiQueryType.SMP;
            bool hasAll = string.IsNullOrWhiteSpace(request.CryID) || request.CryID == SysCtlAllValue.Cry;

            //Query
            var query = from p in _DbSet.DTA_FND_FundCryGroup
                        where p.SysCoID == request.SysCoID
                        select new
                        {
                            p.SysCoID,
                            p.PrtFundCode,
                            p.IssueCry,
                            p.IsRSP
                        };

            #region Conditions

            if (!string.IsNullOrWhiteSpace(request.PrtFundCode))
                query = query.Where(p => p.PrtFundCode == request.PrtFundCode);

            if (query.Any() && !string.IsNullOrWhiteSpace(request.CryID))
            {
                if (request.UIControlType == UICtlType.Searcher && request.SECOptType == SECOptType.Like)
                {
                    query = query.Where(p => p.IssueCry.StartsWith(request.CryID));
                }
                else
                {
                    query = query.Where(p => p.IssueCry == request.CryID);
                }
            }

            if (!string.IsNullOrWhiteSpace(request.FilterItem))
                query = query.Where(p => p.IssueCry != request.FilterItem);

            if (!string.IsNullOrWhiteSpace(request.FeeChargeType))
            {
                string[] arrFeeChargeType = request.FeeChargeType.Trim(',').Split(',');

                var filterQuery = _DbSet.DTA_FND_FundDetail.Select(p => new
                {
                    p.SysCoID,
                    p.PrtFundCode,
                    p.SubsFeeType
                });

                if (arrFeeChargeType.Length > 1)
                    filterQuery = filterQuery.Where(p => arrFeeChargeType.Contains(p.SubsFeeType));
                else
                    filterQuery = filterQuery.Where(p => p.SubsFeeType == arrFeeChargeType.ElementAtOrDefault(0));

                var conditionQuery = filterQuery.Select(p => new
                {
                    p.SysCoID,
                    p.PrtFundCode
                }).Distinct();

                query = from p in query
                        join c in conditionQuery
                          on new { p.SysCoID, p.PrtFundCode } equals new { c.SysCoID, c.PrtFundCode }
                        select p;
            }

            #endregion Conditions

            //Result
            var list = (await query.ToListAsync(cancellationToken))
                       .Select(p => new TAGetDPrtFundIssueCryDTO
                       {
                           CryID = p.IssueCry,
                           IsRSP = p.IsRSP
                       }).ToList();

            //retrieve CryIDNM data and update
            if (list.Count > 0)
            {
                TAFNDFundInfoMethods method = new(_Langid, _IsMainLang);
                //distinct CryID list for SMP Mode and also for GetCryNM request
                List<string> cryIDList = list.Select(p => p.CryID).Distinct().ToList();
                Dictionary<string, (string CryIDNM, int DecLen)> dicCryNM = await method.GetCryNM(string.Join(",", cryIDList));

                if (_QueryTypeIsSMP)
                {
                    list = cryIDList.Select(p => new TAGetDPrtFundIssueCryDTO
                    {
                        CryID = p,
                        CryIDNM = dicCryNM.TryGetValue(p, out var tuple) ? tuple.CryIDNM : string.Empty,
                        IsRSP = string.Empty,
                    }).ToList();
                }
                else
                {
                    list.ForEach(p =>
                    {
                        p.CryIDNM = dicCryNM.TryGetValue(p.CryID, out var tuple) ? tuple.CryIDNM : string.Empty;
                    });
                }
            }

            if (request.IsALL && hasAll)
            {
                //取得 全部幣別 Hub資料
                List<SysAllHubInfo> CryAll = SysAllHub.GetSysAllInfo().Where(p => p.AllKey == SysCtlAll.Cry).ToList();

                TAGetDPrtFundIssueCryDTO _cryAll = CryAll.Select(p => new TAGetDPrtFundIssueCryDTO
                {
                    CryID = p.AllValue,
                    CryIDNM = p.AllName,
                    IsRSP = _QueryTypeIsSMP ? string.Empty : FeatureStatus.Y
                }).First();

                list.Insert(0, _cryAll);
            }

            //回傳結果
            return GetQueryResult<TAGetDPrtFundIssueCryDTO, TAGetDPrtFundIssueCryResponse>(list);
        }
    }

    /// <summary> 取得境內基金可交易幣別代碼(For Searcher) TAGetDTxCry Info Handler </summary>
    public class TAGetDTxCryHandler : BaseHandlerQuery, IRequestHandler<TAGetDTxCryRequest, ResultModel<TAGetDTxCryResponse>>
    {
        /// <summary> TAGetDTxCryHandler Constructor </summary>
        /// <param name="basequery">IBaseQuery</param>
        /// <param name="baseApiService">BaseApiService</param>
        public TAGetDTxCryHandler(IBaseQuery basequery, BaseApiService baseApiService) : base(basequery, baseApiService)
        { }

        /// <summary> 取得境內基金可交易幣別代碼(For Searcher) TAGetDTxCry Info Handler </summary>
        /// <param name="request">TAGetDTxCryRequest</param>
        /// <returns>TAGetDTxCryResponse</returns>
        public async Task<ResultModel<TAGetDTxCryResponse>> Handle(TAGetDTxCryRequest request, CancellationToken cancellationToken)
        {
            GetSystemValueRequest sysRq = new() { SysCode = "000022" };
            GetSysDefValueRequest sysDefRq = new() { SysCode = "000019" };
            bool _QueryTypeIsSMP = request.QueryType == ApiQueryType.SMP;
            //中心幣別
            string CCY = (await BaseHubUtility.GetSystemValue(sysRq)).SysValue;
            //外幣結算幣別
            string[] MCY = ((await BaseHubUtility.GetSysDefValue(sysDefRq)).SysValue).Trim(',').Split(',');
            bool hasAll = string.IsNullOrWhiteSpace(request.CryID) || request.CryID.Split(',').Contains(SysCtlAllValue.Cry);

            //Query
            var query = from p in _DbSet.DTA_FND_FundTxCry
                        where p.SysCoID == request.SysCoID
                        select new
                        {
                            p.SysCoID,
                            p.PrtFundCode,
                            p.FundCode,
                            p.CryID,
                            p.CryDataSrc
                        };

            #region Conditions

            if (!string.IsNullOrWhiteSpace(request.PrtFundCode))
                query = query.Where(p => p.PrtFundCode == request.PrtFundCode);

            if (query.Any() && !string.IsNullOrWhiteSpace(request.CryID))
            {
                if (request.UIControlType == UICtlType.Searcher && request.SECOptType == SECOptType.Like)
                {
                    query = query.Where(p => p.CryID.StartsWith(request.CryID));
                }
                else
                {
                    string[] aryCry = request.CryID.Split(',');
                    query = query.Where(p => aryCry.Contains(p.CryID));
                }
            }

            if (!string.IsNullOrWhiteSpace(request.CryDataSrc))
                query = query.Where(p => p.CryDataSrc == request.CryDataSrc);

            if (request.IsExcludeCCY)
                query = query.Where(p => p.CryID != CCY);

            #endregion Conditions

            List<string> data = await query.Select(p => p.CryID).Distinct().ToListAsync(cancellationToken);

            //Result
            List<TAGetDTxCryDTO> list = data.Select(p => new TAGetDTxCryDTO
            {
                CryID = p,
                IsMCY = _QueryTypeIsSMP ? string.Empty : (p == CCY || MCY.Contains(p)) ? MapYN.No : MapYN.Yes
            }).ToList();

            //retrieve CryIDNM data and update
            if (list.Count > 0)
            {
                TAFNDFundInfoMethods method = new(_Langid, _IsMainLang);
                Dictionary<string, (string, int)> dicCryNM = await method.GetCryNM(string.Join(",", data));
                (string CryIDNM, int DecLen) tuple;

                list.ForEach(p =>
                {
                    p.CryIDNM = string.Empty;
                    p.DecLen = 0;

                    if (dicCryNM.TryGetValue(p.CryID, out tuple))
                    {
                        p.CryIDNM = tuple.CryIDNM;
                        p.DecLen = tuple.DecLen;
                    }
                });
            }

            if (request.IsALL && hasAll)
            {
                //取得 全部幣別 Hub資料
                List<SysAllHubInfo> CryAll = SysAllHub.GetSysAllInfo().Where(p => p.AllKey == SysCtlAll.Cry).ToList();

                TAGetDTxCryDTO _cryAll = CryAll.Select(p => new TAGetDTxCryDTO
                {
                    CryID = p.AllValue,
                    CryIDNM = p.AllName,
                    DecLen = 0,
                    IsMCY = _QueryTypeIsSMP ? string.Empty : MapYN.No
                }).First();

                list.Insert(0, _cryAll);
            }

            //回傳結果
            return GetQueryResult<TAGetDTxCryDTO, TAGetDTxCryResponse>(list);
        }
    }

