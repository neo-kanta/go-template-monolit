# ───── Stage 1: Build ─────
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache gcc musl-dev

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/fnd ./services/fnd/cmd/fnd

# ───── Stage 2: Run ─────
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /bin/fnd /usr/local/bin/fnd

EXPOSE 50051

ENTRYPOINT ["fnd"]
